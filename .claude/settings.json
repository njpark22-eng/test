{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(curl:*)",
      "Edit(./data/**)",
      "Write(./data/**)",
      "Edit(**/*.xlsx)",
      "Write(**/*.xlsx)",
      "Edit(**/*.xlsm)",
      "Write(**/*.xlsm)",
      "Edit(**/*.xls)",
      "Write(**/*.xls)",
      "Bash(printenv:*)",
      "Bash(env:*)",
      "Bash(rm result-*:*)",
      "Bash(mv result-*:*)",
      "Write(./review-*.json)",
      "Edit(./review-*.json)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "uv run pytest -q"
          },
          {
            "type": "command",
            "command": "python .claude/hooks/check_rules_sync.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/block_input_excel.py"
          },
          {
            "type": "command",
            "command": "python .claude/hooks/guard_demo.py"
          }
        ]
      }
    ]
  }
}